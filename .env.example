# Environment Configuration
NODE_ENV=development

# Database Configuration
# PostgreSQL Database URLs
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NON_POOLING=""

# Google Sheets API Configuration
# Get these from Google Cloud Console (Service Account)
GOOGLE_SHEETS_PRIVATE_KEY=""
GOOGLE_SHEETS_CLIENT_EMAIL=""
GOOGLE_SHEETS_SPREADSHEET_ID=""

# Database-backed widgets show unavailable locally until both URLs are configured.
# Copy real development database URLs into .env.local; do not use production for testing.
# Opt in to verbose Prisma SQL logging only when troubleshooting:
PRISMA_LOG_QUERIES=false
