generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Views {
  slug  String @id
  count Int    @default(0)
}

model SpotifyListening {
  id          String    @id
  state       String    @default("unavailable")
  trackId     String?
  trackKind   String?
  observedAt  DateTime?
  checkedAt   DateTime?
  nextCheckAt DateTime  @default(now())
  leaseToken  String?
  leaseUntil  DateTime?
}
